# ── Supabase (Project Settings → API) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server only. Never expose in the browser. Used only to invite team members.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sitepilot.evynta.in

# ── AI Site Assistant (optional) ────────────────────────────────
# Without a key the assistant still answers from your records using built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
